universe = vanilla
container_image = osdf:///chtc/staging/k/kli398/hep_ssl.sif
executable = run_classifier.sh
run_id = phase1
arguments = $(run_id) pretrained
transfer_input_files = hep_ssl-code.tar.gz, prepared-data.tar.gz, result_$(run_id).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = result_classifier_$(run_id)_pretrained.tar.gz
log = classifier_$(Cluster)_$(Process).log
output = classifier_$(Cluster)_$(Process).out
error = classifier_$(Cluster)_$(Process).err
+WantGPULab = true
+GPUJobLength = "short"
request_gpus = 1
request_cpus = 2
request_memory = 64GB
request_disk = 30GB
queue 1
