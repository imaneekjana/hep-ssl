universe = vanilla

batch_name = colliderml_pairwise_2500_download

container_image = osdf:///chtc/staging/k/kli398/hep_ssl.sif

executable = download_data_pairwise_2500.sh

transfer_input_files = \
    download_data_pairwise_2500.py, \
    osdf:///chtc/staging/k/kli398/colliderml-data-v1.tar.gz

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_output_files = colliderml-data-pairwise-2500.tar.gz
transfer_output_remaps = "colliderml-data-pairwise-2500.tar.gz = file:///staging/k/kli398/colliderml-data-pairwise-2500.tar.gz"

log = download_pairwise_2500_$(Cluster).log
output = download_pairwise_2500_$(Cluster).out
error = download_pairwise_2500_$(Cluster).err

requirements = (HasCHTCStaging == true)

request_cpus = 1
request_memory = 8GB
request_disk = 30GB

queue
