universe = vanilla

batch_name = gravnet_pairwise_augmentation_sweep_20260812

container_image = osdf:///chtc/staging/k/kli398/hep_ssl.sif

executable = run_experiment.sh

arguments = $(exp_name) $(channel_a) $(channel_b) $(events_per_channel) $(rotation_mode) $(rotation) $(energy_noise) $(xyz_noise) $(shift_std) $(crop_fraction) $(aug_order) $(learning_rate) $(weight_decay) $(batch_size) $(temperature) $(seed)

transfer_input_files = \
    hep_ssl-code.tar.gz, \
    osdf:///chtc/staging/k/kli398/colliderml-data-pairwise-2500.tar.gz

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_output_files = result_$(exp_name).tar.gz

log = sweep_$(Cluster)_$(Process)_$(exp_name).log
output = sweep_$(Cluster)_$(Process)_$(exp_name).out
error = sweep_$(Cluster)_$(Process)_$(exp_name).err

+WantGPULab = true
+GPUJobLength = "medium"

request_gpus = 1
request_cpus = 2
request_memory = 64GB
request_disk = 30GB

queue exp_name, channel_a, channel_b, events_per_channel, rotation_mode, rotation, energy_noise, xyz_noise, shift_std, crop_fraction, aug_order, learning_rate, weight_decay, batch_size, temperature, seed from [1:] experiments.txt

