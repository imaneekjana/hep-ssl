# One explicitly configured run. No automatic parameter sweep.
# Submit from the staging directory containing the four transferred files.
universe = vanilla
container_image = osdf:///chtc/staging/k/kli398/hep_ssl.sif
executable = run_experiment.sh
run_id = phase1
config_file = pairwise_base.json
arguments = $(run_id) $(config_file)
transfer_input_files = hep_ssl-code.tar.gz, prepared-data.tar.gz, $(config_file)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = result_$(run_id).tar.gz
log = train_$(Cluster)_$(Process).log
output = train_$(Cluster)_$(Process).out
error = train_$(Cluster)_$(Process).err
+WantGPULab = true
+GPUJobLength = "medium"
request_gpus = 1
request_cpus = 2
request_memory = 64GB
request_disk = 30GB
queue 1
